{
  "name": "chatgpt-quota-widget",
  "version": "0.1.0",
  "description": "Windows desktop LED widget for showing local ChatGPT (desktop) usage quota.",
  "main": "src/main/main.js",
  "author": "baiyeyshsbsu",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "node --test",
    "build": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win portable",
    "build:dir": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --dir"
  },
  "build": {
    "appId": "cn.baiyeyshsbsu.chatgpt.quota.widget",
    "productName": "ChatGPT Quota Widget",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "ChatGPT-Quota-Widget-${version}-win-x64.exe"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
